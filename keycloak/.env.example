# Versões validadas em agosto de 2026 para Ubuntu Server 26.04 LTS.
KEYCLOAK_VERSION="26.7.1"
KEYCLOAK_SHA256="d3bb3da0e4bf574db0c857f92b272da90575dc97aa26c41329c9d4399200974c"
JAVA_PACKAGE="openjdk-25-jre-headless"
POSTGRESQL_MAJOR="18"

# Nome DNS estável, resolvível pelo servidor Keycloak, pelo control plane
# Kubernetes e pelos navegadores dos operadores.
KEYCLOAK_HOSTNAME="idp.lab.example.com"
KEYCLOAK_SERVER_IP="192.168.1.40"
KEYCLOAK_HTTPS_PORT="8443"

# TLS_MODE aceita "self-signed" (CA privada gerada pelo instalador) ou
# "provided" (certificado/chain e chave fornecidos pelo administrador).
TLS_MODE="self-signed"
TLS_CERT_FILE=""
TLS_KEY_FILE=""
TLS_CA_FILE=""
TLS_CERT_DAYS="825"

# Banco local dedicado. TCP/5432 nunca é aberto pelo instalador.
KEYCLOAK_DB_NAME="keycloak"
KEYCLOAK_DB_USER="keycloak"
KEYCLOAK_DB_POOL_INITIAL_SIZE="5"
KEYCLOAK_DB_POOL_MIN_SIZE="5"
KEYCLOAK_DB_POOL_MAX_SIZE="20"

# JVM e conta administrativa permanente do realm master.
KEYCLOAK_JAVA_HEAP="-Xms512m -Xmx1536m"
KEYCLOAK_ADMIN_USER="idp-admin"
KEYCLOAK_BOOTSTRAP_USER="bootstrap-admin"

# Realm e cliente usados inicialmente pelo Kubernetes/Headlamp.
OIDC_REALM="platform"
OIDC_REALM_DISPLAY_NAME="Plataforma"
OIDC_CLIENT_ID="kubernetes"
OIDC_VIEWER_GROUP="k8s-viewers"
OIDC_ADMIN_GROUP="k8s-admins"
HEADLAMP_EXTERNAL_URL="https://k8s.lab.example.com:30443"
KUBECTL_OIDC_REDIRECT_URI="http://localhost:8000"

# Firewall do host. Separe múltiplos CIDRs com vírgula, sem espaços.
# O acesso ao IdP precisa incluir control planes e redes dos navegadores.
KEYCLOAK_ALLOWED_CIDRS="192.168.0.0/16"
SSH_ALLOWED_CIDRS="192.168.0.0/16"
SSH_PORT="22"
ENABLE_UFW="true"

# Backup lógico diário local. Copie os backups para outro host/storage.
BACKUP_RETENTION_DAYS="14"
BACKUP_ON_CALENDAR="*-*-* 02:15:00"

# Use true somente para testes em outra versão do Ubuntu.
ALLOW_UNSUPPORTED_OS="false"

