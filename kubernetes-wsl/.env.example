# Versões de referência para Ubuntu 26.04 no WSL 2.
KUBERNETES_MINOR="v1.36"
POD_NETWORK_CIDR="10.244.0.0/16"
SERVICE_CIDR="10.96.0.0/12"

# Endereço estável criado na interface loopback do WSL. Não use um endereço
# pertencente às redes de Pods, Services, VPN ou rede corporativa.
NODE_IP="10.254.254.1"
NODE_NAME="kubernetes-wsl"

# Usuário Linux que receberá ~/.kube/config. Vazio usa o usuário que chamou sudo.
ADMIN_USER=""
SINGLE_NODE="true"

# Headlamp local. O acesso fica restrito a 127.0.0.1 e usa a ServiceAccount
# interna do Headlamp, sem OIDC e sem colar tokens no navegador.
DASHBOARD_NAMESPACE="kubernetes-dashboard"
DASHBOARD_LOCAL_PORT="30443"
DASHBOARD_CERT_DAYS="825"
DASHBOARD_DEFAULT_LANGUAGE="pt"
HEADLAMP_IMAGE="ghcr.io/headlamp-k8s/headlamp:v0.45.0"
DASHBOARD_ROLLOUT_TIMEOUT="10m"

FLANNEL_VERSION="v0.28.8"
FLANNEL_SHA256="4148e659a834b51fc9aadc429281c6e80c97e0e25475faacd4cc857dbd16f21b"

# Gateway API Standard + Envoy Gateway. O proxy gerado permanece ClusterIP;
# GATEWAY_LOCAL_PORT so e publicado em 127.0.0.1 quando o tunel for aberto.
HELM_VERSION="v4.3.0"
HELM_SHA256_AMD64="86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb"
HELM_SHA256_ARM64="31c5794dd55c66a51e6b7d2e2ac7a114ae8b1de41ff1d9ba51748ac973b06a08"
GATEWAY_API_VERSION="v1.6.1"
ENVOY_GATEWAY_VERSION="v1.9.1"
ENVOY_GATEWAY_CHART_SHA256="68ce74961eeb5fc5e395628d6bbed9305a85b34619bd7ee17b01187f101bb8c5"
ENVOY_GATEWAY_CRDS_CHART_SHA256="ad2e1215749249ff6c8a2d82fb820c70edbb18a7ffc7331355632fb67b944688"
ENVOY_GATEWAY_NAMESPACE="envoy-gateway-system"
ENVOY_GATEWAY_RELEASE="eg"
ENVOY_PROXY_NAME="wsl-local"
GATEWAY_CLASS_NAME="envoy-wsl"
GATEWAY_NAMESPACE="gateway-system"
GATEWAY_NAME="wsl-gateway"
GATEWAY_LISTENER_PORT="8080"
GATEWAY_LOCAL_PORT="30080"

# Use true apenas para testes conscientes em outra versão do Ubuntu.
ALLOW_UNSUPPORTED_OS="false"

# Use true apenas se você aceitou executar abaixo dos mínimos recomendados.
ALLOW_LOW_RESOURCES="false"

# Repara resíduos de kubeadm init somente quando admin.conf não existe e a API
# local não responde. Um cluster existente nunca é resetado automaticamente.
AUTO_REPAIR_PARTIAL_CLUSTER="true"
