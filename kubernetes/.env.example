# Versões de referência atuais em julho de 2026.
KUBERNETES_MINOR="v1.36"
POD_NETWORK_CIDR="10.244.0.0/16"
SERVICE_CIDR="10.96.0.0/12"

# Deixe vazio para detectar o IPv4 da rota padrão.
NODE_IP=""
NODE_NAME=""

# Usuário Linux que receberá ~/.kube/config. Quando vazio, usa SUDO_USER
# ou cria o usuário k8sadmin se o instalador for chamado diretamente por root.
ADMIN_USER=""
ADMIN_GROUP="k8s-operators"
SINGLE_NODE="true"

# Dashboard Web (Headlamp). NodePort precisa estar entre 30000 e 32767.
DASHBOARD_NAMESPACE="kubernetes-dashboard"
DASHBOARD_NODE_PORT="30443"
DASHBOARD_ALLOWED_CIDR="0.0.0.0/0"
DASHBOARD_DNS_NAME=""
DASHBOARD_PUBLIC_IP=""
DASHBOARD_CERT_DAYS="825"
# Headlamp detecta o idioma no navegador; a URL gerada força este idioma.
DASHBOARD_DEFAULT_LANGUAGE="en"
HEADLAMP_IMAGE="ghcr.io/headlamp-k8s/headlamp:v0.43.0"
DASHBOARD_ROLLOUT_TIMEOUT="10m"

# Perfis de login de contingência por ServiceAccount. O acesso normal usa OIDC.
CREATE_ADMIN_SERVICE_ACCOUNT="false"
DEFAULT_TOKEN_DURATION="8h"

# OIDC com o Keycloak instalado pelo diretório ../keycloak.
ENABLE_OIDC="true"
OIDC_ISSUER_URL="https://idp.lab.example.com:8443/realms/platform"
OIDC_CLIENT_ID="kubernetes"
OIDC_USERNAME_PREFIX="oidc:"
OIDC_GROUPS_PREFIX="oidc:"
OIDC_VIEWER_GROUP="k8s-viewers"
OIDC_ADMIN_GROUP="k8s-admins"
OIDC_ENABLE_ADMIN_GROUP="true"
HEADLAMP_EXTERNAL_URL="https://k8s.lab.example.com:30443"
HEADLAMP_OIDC_SCOPES="openid,profile,email"
# CA privada copiada do servidor Keycloak. Deixe vazio para certificado público.
OIDC_CA_FILE="/root/keycloak-ca.crt"

# Rede e firewall do host.
FLANNEL_VERSION="v0.28.4"
FLANNEL_SHA256="d078019743c5e0194ce965125fc80ef00af0c1661ec9e12396311f1cfec860a2"
ENABLE_UFW="true"
SSH_PORT="22"

# Use true somente para testes em outra versão do Ubuntu.
ALLOW_UNSUPPORTED_OS="false"

# Remove resíduos de um kubeadm init interrompido SOMENTE quando admin.conf
# não existe e a API local não está acessível. Nunca reseta um cluster ativo.
AUTO_REPAIR_PARTIAL_CLUSTER="true"
